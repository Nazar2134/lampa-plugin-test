<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/back"
            style="@style/ToolbarIcon"
            android:contentDescription="Back to the book"
            android:src="@drawable/ic_back"
            android:tint="@color/on_surface" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingHorizontal="12dp">

        <TextView android:id="@+id/tabContents" style="@style/Tab" android:text="Contents" />
        <TextView android:id="@+id/tabBookmarks" style="@style/Tab" android:text="Bookmarks" />
        <TextView android:id="@+id/tabNotes" style="@style/Tab" android:text="Notes" />
        <TextView android:id="@+id/tabSearch" style="@style/Tab" android:text="Search" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/field" />

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/query"
            style="@style/Field"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:drawableTint="@color/muted"
            android:hint="Search in this book"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:id="@+id/searchInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:padding="32dp"
        android:textColor="@color/muted"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>

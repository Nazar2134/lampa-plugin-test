<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.aireader.app.ReaderWebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:ellipsize="middle"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingBottom="12dp"
        android:singleLine="true"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/back"
            style="@style/ToolbarIcon"
            android:contentDescription="Library"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/bookTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:paddingHorizontal="4dp"
            android:singleLine="true"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/askAi"
            style="@style/ToolbarIcon"
            android:contentDescription="Ask AI about this page"
            android:src="@drawable/ic_sparkle" />

        <ImageButton
            android:id="@+id/toc"
            style="@style/ToolbarIcon"
            android:contentDescription="Contents"
            android:src="@drawable/ic_toc" />

        <TextView
            android:id="@+id/style"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Text style"
            android:gravity="center"
            android:text="Aa"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stylePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="110dp"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/fontSmaller"
                style="@style/StyleChip"
                android:text="A−"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/fontSizeLabel"
                style="@style/StyleChip"
                android:background="@null" />

            <TextView
                android:id="@+id/fontBigger"
                style="@style/StyleChip"
                android:text="A+"
                android:textSize="21sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/fontSerif"
                style="@style/StyleChip"
                android:fontFamily="serif"
                android:text="Serif" />

            <TextView
                android:id="@+id/fontSans"
                style="@style/StyleChip"
                android:fontFamily="sans-serif"
                android:text="Sans" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/themeLight"
                style="@style/StyleChip"
                android:text="Light" />

            <TextView
                android:id="@+id/themeSepia"
                style="@style/StyleChip"
                android:text="Sepia" />

            <TextView
                android:id="@+id/themeDark"
                style="@style/StyleChip"
                android:text="Dark" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aiPanel"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top">

            <TextView
                android:id="@+id/aiQuote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:padding="10dp"
                android:textSize="14sp"
                android:textStyle="italic" />

            <ImageButton
                android:id="@+id/aiClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/aiScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/aiAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.25"
                    android:textIsSelectable="true"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/aiProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/aiSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_bg"
                    android:paddingHorizontal="20dp"
                    android:text="Open settings"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/aiInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Ask a follow-up…"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:padding="12dp"
                android:textSize="15sp" />

            <Button
                android:id="@+id/aiSend"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_bg"
                android:minWidth="64dp"
                android:text="Ask"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/aiClaude"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="Ask Claude ↗"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/aiChatgpt"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="Ask ChatGPT ↗"
                android:textAllCaps="false" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/aiCopy"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="Copy"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

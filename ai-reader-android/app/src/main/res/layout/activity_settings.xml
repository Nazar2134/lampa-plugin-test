<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/on_surface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SectionLabel"
            android:text="Explain in this language" />

        <EditText
            android:id="@+id/language"
            style="@style/Field"
            android:hint="e.g. English, Ukrainian"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <TextView
            style="@style/SectionLabel"
            android:text="How much detail" />

        <RadioGroup
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/detailBrief"
                style="@style/Choice"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Brief" />

            <RadioButton
                android:id="@+id/detailFull"
                style="@style/Choice"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Detailed" />
        </RadioGroup>

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="32dp"
            android:text="Answers inside the reader"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/providerGemini"
                style="@style/Choice"
                android:text="Google Gemini: free with a Google account" />

            <RadioButton
                android:id="@+id/providerDeepseek"
                style="@style/Choice"
                android:text="DeepSeek: your API key, pay per use" />
        </RadioGroup>

        <!-- Gemini -->
        <LinearLayout
            android:id="@+id/geminiSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:text="Get a key at Google AI Studio: sign in with a Google account, tap “Create API key”, and paste it here. No card needed. The free tier has daily limits, and Google may use free-tier requests to improve its models."
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/getGeminiKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:text="Get a free key at aistudio.google.com →"
                android:textColor="@color/accent"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/geminiKey"
                style="@style/Field"
                android:hint="Paste your Gemini API key"
                android:inputType="textPassword"
                android:singleLine="true" />

            <RadioGroup
                android:id="@+id/geminiModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/geminiFlash"
                    style="@style/Choice"
                    android:text="Gemini Flash: better explanations" />

                <RadioButton
                    android:id="@+id/geminiLite"
                    style="@style/Choice"
                    android:text="Gemini Flash-Lite: faster, more free requests" />
            </RadioGroup>
        </LinearLayout>

        <!-- DeepSeek -->
        <LinearLayout
            android:id="@+id/deepseekSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:text="Answers are paid from your DeepSeek balance. With Flash, a typical explanation costs well under $0.001."
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/getDeepseekKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:text="Manage keys at platform.deepseek.com →"
                android:textColor="@color/accent"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/deepseekKey"
                style="@style/Field"
                android:hint="Paste your DeepSeek API key (sk-…)"
                android:inputType="textPassword"
                android:singleLine="true" />

            <RadioGroup
                android:id="@+id/deepseekModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/deepseekFlash"
                    style="@style/Choice"
                    android:text="DeepSeek Flash: fast, cheapest" />

                <RadioButton
                    android:id="@+id/deepseekPro"
                    style="@style/Choice"
                    android:text="DeepSeek V4 Pro: thinks first, slower, about 3–4× the price" />
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/check"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/field_bg"
            android:text="Save and test the key"
            android:textAllCaps="false"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/checkResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="32dp"
            android:text="What is sent to the AI"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:text="Books stay on your phone. When you use an AI action, only the text you selected, its paragraph, and for questions a few passages found by searching the part of the book you've already read are sent to the provider you chose, along with the book's title and author. Repeated explanations are answered from a local cache."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="32dp"
            android:text="Ask Claude / Ask ChatGPT"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:text="These buttons, and ChatGPT in the selection bar, open ChatGPT or Claude in a window over the book with your question already written, using your own account in Chrome (sign in there once). Swipe the window down to keep reading."
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Body"
            android:layout_marginBottom="18dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/tagline"
            android:textColor="@color/text_muted" />

        <!-- 1 · API key -->
        <LinearLayout style="@style/Section">

            <TextView style="@style/SectionTitle" android:text="@string/key_title" />

            <TextView style="@style/Body" android:text="@string/key_help" android:textColor="@color/text_muted" />

            <EditText
                android:id="@+id/api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:hint="sk-…"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/get_key"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/get_key"
                    android:textColor="@color/accent" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/test_key"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save_test" />
            </LinearLayout>

            <TextView
                android:id="@+id/key_status"
                style="@style/Body"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 2 · Languages -->
        <LinearLayout style="@style/Section">

            <TextView style="@style/SectionTitle" android:text="@string/lang_title" />

            <TextView style="@style/Label" android:text="@string/my_lang_label" />

            <AutoCompleteTextView
                android:id="@+id/my_lang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="1"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:singleLine="true" />

            <TextView style="@style/Label" android:text="@string/other_lang_label" />

            <AutoCompleteTextView
                android:id="@+id/other_lang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="1"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 3 · Model -->
        <LinearLayout style="@style/Section">

            <TextView style="@style/SectionTitle" android:text="@string/model_title" />

            <RadioGroup
                android:id="@+id/model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/model_chat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/model_chat" />

                <RadioButton
                    android:id="@+id/model_reasoner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/model_reasoner" />
            </RadioGroup>
        </LinearLayout>

        <!-- 4 · Try it -->
        <LinearLayout style="@style/Section">

            <TextView style="@style/SectionTitle" android:text="@string/try_title" />

            <TextView style="@style/Body" android:text="@string/try_help" android:textColor="@color/text_muted" />

            <EditText
                android:id="@+id/try_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:text="@string/sample_text" />

            <Button
                android:id="@+id/try_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/try_button" />
        </LinearLayout>

        <!-- 5 · Tap any word -->
        <LinearLayout style="@style/Section">

            <TextView style="@style/SectionTitle" android:text="@string/tap_title" />

            <TextView style="@style/Body" android:text="@string/tap_help" />

            <TextView
                android:id="@+id/tap_status"
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/open_accessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/open_accessibility" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="6dp"
                android:text="@string/restricted_help"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/open_app_info"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_app_info"
                android:textColor="@color/accent" />

            <Switch
                android:id="@+id/bubble_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/bubble_switch"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 6 · More ways -->
        <LinearLayout style="@style/Section">

            <TextView style="@style/SectionTitle" android:text="@string/more_title" />

            <TextView style="@style/Body" android:text="@string/more_help" />
        </LinearLayout>

        <!-- Advanced -->
        <LinearLayout style="@style/Section">

            <TextView style="@style/SectionTitle" android:text="@string/advanced_title" />

            <TextView style="@style/Label" android:layout_marginTop="0dp" android:text="@string/base_url_label" />

            <EditText
                android:id="@+id/base_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
